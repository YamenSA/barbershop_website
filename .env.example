DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/barbershop
RETENTION_GUEST_MONTHS=12
RETENTION_CUSTOMER_MONTHS=12
# Required — backend refuses to start without it (protects the retention endpoint).
RETENTION_CRON_SECRET=generate_a_secure_random_string_here
# Logs every SQL query incl. bound parameters (may include customer PII). Local debugging only — never True in production.
SQL_ECHO=False
# Required — backend refuses to start without it (M20). Which peers uvicorn trusts to set
# X-Forwarded-For; anything else falls back to the raw TCP peer address. Local dev without
# Docker (direct `uvicorn --reload`): 127.0.0.1 (uvicorn's own default, no proxy involved).
# Docker Compose/Coolify: NOT hardcoded here — this repo doesn't pin the Docker network
# subnet (Coolify manages that network itself; a subnet can't be changed on an existing
# network, so pinning one here risks breaking or recreating it on deploy). Set via Coolify's
# own environment variables instead. Verify the actual subnet first — `docker network
# inspect <network-id>` — don't guess: recommended value is that subnet's /8 (e.g. observed
# 10.0.2.0/24 -> use 10.0.0.0/8, which also survives Coolify recreating the network on a
# different /24 within the same private block). Never "*" unless the backend is guaranteed
# to have no exposed host port (spoofable X-Forwarded-For otherwise). A value that no longer
# covers the container's own address logs a startup warning (app/core/logging.py) — check
# for it after any Coolify network change.
FORWARDED_ALLOW_IPS=127.0.0.1

# Phase 1: Admin & Auth
JWT_SECRET_KEY=generate_a_secure_random_string_here
SESSION_EXPIRE_HOURS=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
RATE_LIMIT_LOGIN_PER_MINUTE=20
COOKIE_SECURE=False

# Phase 2 / Public booking settings
BREVO_API_KEY=
EMAIL_FROM=buchung@azzam-salon.de
EMAIL_FROM_NAME=Azzam Barbershop
EMAIL_REPLY_TO=Oazzam412@gmail.com
PUBLIC_BASE_URL=http://localhost:3000
BOOKING_MIN_LEAD_HOURS=2
BOOKING_MAX_HORIZON_DAYS=60
REMINDER_LEAD_HOURS=24
REMINDER_SCAN_INTERVAL_HOURS=1
CANCELLATION_CUTOFF_HOURS=24
RATE_LIMIT_BOOKING_PER_MINUTE=10
